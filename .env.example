# Copy this file to .env and fill in the values from your Supabase
# project (Project Settings -> API). Never commit the real .env.
#
# Both values are read at BUILD time, not run time. If they are
# missing, `npm run build` still exits 0 but ships a blank page, so
# make sure they are set before building or deploying.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_your-key-here
