# Copy this file to .env and fill in the values from your Supabase
# project (Project Settings -> API). Never commit the real .env.
#
# Both values are read at BUILD time, not run time. If they are
# missing, `npm run build` still exits 0 but ships a blank page, so
# make sure they are set before building or deploying.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# ── Optional, set in Vercel only ──────────────────────────────
# GENERATE_SOURCEMAP=false
#
# CRA ships source maps by default. They are ~7 MB of the deployed
# build and are publicly fetchable, so anyone can reconstruct the
# original JSX from the live site. Nothing secret lives in the
# frontend, but there is no reason to publish it either.
#
# Set this in Vercel -> Settings -> Environment Variables rather than
# in the build script, so local `npm start` keeps its source maps for
# debugging, and so the command still works on Windows.
